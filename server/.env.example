# Copy this file to .env (same folder) and fill in your own values.
# .env is ignored by git — never commit it or paste keys into chat.
# On Render, set the same names under the web service → Environment.

# ── Storage ────────────────────────────────────────────────
# Folder for the database + uploaded videos. Leave empty locally (uses server/.localdb).
# On Render: the persistent disk's mount path, e.g. /var/data
DATA_DIR=
# Optional upgrade later: a managed Postgres URL. Leave empty to use the embedded database.
DATABASE_URL=

# ── Site ───────────────────────────────────────────────────
# Used to build links in emails and Stripe redirects.
PUBLIC_BASE_URL=http://localhost:3000

# ── Stripe (step 3) ────────────────────────────────────────
# Stripe dashboard → turn on "Test mode" → Developers → API keys → Secret key (starts sk_test_)
# Leave empty to run without payments (bookings just reserve the bikes).
STRIPE_SECRET_KEY=
# Local: printed by `stripe listen` (starts whsec_).
# Render: Stripe → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=

# ── Email via Resend (step 4) ──────────────────────────────
# resend.com → API Keys → Create (permission: "Sending access") — starts re_
# Leave empty locally: emails are saved as .html files in server/.localdb/outbox instead.
RESEND_API_KEY=
# The sender. Must be on a domain you've verified in Resend → Domains (add the DNS
# records it shows at your domain registrar). Until then, use onboarding@resend.dev,
# which can only send to the email address you signed up to Resend with.
EMAIL_FROM="Airlie Scooter Hire <bookings@airliescooterhire.com>"
# Where new-booking notifications go (your own inbox). Customers' replies come here too.
OWNER_NOTIFY_EMAIL=

# ── Admin page ─────────────────────────────────────────────
# Open /admin (or tap the "Airlie Scooter Hire" logo on the home page 5 times).
# Your PIN. Wrong guesses are limited to 5 per 15 minutes. Leave empty to switch admin off.
ADMIN_PIN=
# A long random string that signs admin logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it (or ADMIN_PIN) logs every device out.
SESSION_SECRET=
